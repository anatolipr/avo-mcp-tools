{
  "name": "avo-mcp-terminal",
  "version": "0.1.1",
  "type": "module",
  "description": "Sandboxed filesystem/terminal tools for agents, exposed both as a real MCP stdio server and as a human-relay TUI (copy/paste bridge) for agents with no direct tool access.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolipr/avo-mcp-tools.git",
    "directory": "packages/mcp-terminal"
  },
  "license": "MIT",
  "bin": {
    "mcp-terminal": "bin/mcp-terminal.js"
  },
  "main": "dist/src/mcp-server.js",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "mcp": "tsx src/mcp-server.ts",
    "relay": "tsx src/relay-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "diff": "^8.0.0",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

{
  "name": "mcp-form",
  "version": "0.1.15",
  "type": "module",
  "description": "Tiny Lit web component with a signal-backed text field, synced live to an MCP server so an agent can read/write it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolipr/avo-mcp-tools.git",
    "directory": "packages/mcp-form"
  },
  "license": "MIT",
  "bin": {
    "mcp-form": "./bin/mcp-form.js"
  },
  "main": "dist/src/server.js",
  "files": [
    "bin",
    "dist",
    "config",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "vite build --watch",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "prestart": "npm run build",
    "start": "tsx src/server.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "stop": "kill -9 $(lsof -ti :${PORT:-8765}) 2>/dev/null && echo 'Server stopped' || echo 'No server running'"
  },
  "dependencies": {
    "mcp-tenant-lib": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "avosignals": "^1.0.16",
    "lit": "^3.3.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}

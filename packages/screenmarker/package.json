{
  "name": "screenmarker",
  "version": "0.2.2",
  "type": "module",
  "description": "Paste a screenshot, annotate it with arrows/boxes/text/pen/highlight, and copy the flattened image back to the clipboard.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolipr/avo-mcp-tools.git",
    "directory": "packages/screenmarker"
  },
  "license": "MIT",
  "bin": {
    "screenmarker": "./bin/screenmarker.js"
  },
  "main": "dist/src/server.js",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "vite build --watch",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "prestart": "npm run build",
    "start": "tsx src/server.ts",
    "start:hosted": "VITE_SCREENMARKER_HOSTED=1 npm run build && tsx src/server.ts",
    "prepublishOnly": "npm run build",
    "deploy": "npm run build && wrangler pages deploy",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "stop": "kill -9 $(lsof -ti :${PORT:-8766}) 2>/dev/null && echo 'Server stopped' || echo 'No server running'"
  },
  "dependencies": {
    "avosignals": "^1.0.16",
    "lit": "^3.3.3",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}

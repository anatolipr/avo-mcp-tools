{
  "manifest_version": 3,
  "name": "js-bridge-mcp Connector",
  "version": "0.1.0",
  "description": "Keeps js-bridge-mcp page connections alive across reloads and exposes a privileged extension-side tool channel.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["scripting", "tabs", "webNavigation", "webRequest", "storage", "alarms", "notifications", "debugger"],
  "host_permissions": ["http://localhost:8766/*", "<all_urls>"]
}

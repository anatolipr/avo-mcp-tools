{
  "name": "mcp-tenant-lib",
  "version": "0.4.0",
  "type": "module",
  "description": "Generic tenant/session bookkeeping + MCP wiring, reusable across projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolipr/avo-mcp-tools.git",
    "directory": "packages/mcp-tenant-lib"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-bridge.d.ts",
      "default": "./dist/client-bridge.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fastest-levenshtein": "^1.0.16",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
